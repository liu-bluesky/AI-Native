VITE_API_PROXY_TARGET=http://127.0.0.1:8000
# 本地开发时是否展示 AI 对话设置中的本机控制项
VITE_SHOW_LOCAL_RUNTIME_SETTINGS=false
# 构建时媒体能力：图片和视频默认编入，语音生成与音频转写默认不编入。
VITE_ENABLE_MEDIA_IMAGE=true
VITE_ENABLE_MEDIA_VIDEO=false
VITE_ENABLE_MEDIA_AUDIO_GENERATION=false
VITE_ENABLE_MEDIA_AUDIO_TRANSCRIPTION=false
# 全局助手语音和欢迎语默认不编入；修改后重新打包生效。
VITE_ENABLE_GLOBAL_ASSISTANT_VOICE=false
VITE_ENABLE_GLOBAL_ASSISTANT_GREETING=false
